# PlantWise AI backend configuration
# Copy to `.env` and adjust. Every value has a working default.

# --- Application ---
ENVIRONMENT=development
DEBUG=false

# Comma separated list of allowed browser origins. Never use a wildcard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Persistence ---
# Defaults to a SQLite file inside the backend directory.
DATABASE_URL=sqlite+aiosqlite:///./plantwise.db
SEED_ON_STARTUP=true

# --- AI assistant (hosted open-weight via OpenRouter) ---
# The assistant is optional. An empty OPENROUTER_API_KEY disables it and the
# rest of the app keeps working. Get a key at https://openrouter.ai/settings/keys
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Free open-weight model served by OpenRouter (Google Gemma 4). Model IDs change;
# browse the live catalog at https://openrouter.ai/models and set OPENROUTER_MODEL.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Comma separated. Tried in order if the primary model errors or is rate-limited;
# free model pools are shared, so this keeps the assistant answering.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=30
AI_CONNECT_TIMEOUT_SECONDS=5
AI_TEMPERATURE=0.3
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_OUTPUT_CHARS=4000
# Optional attribution fields shown on OpenRouter's public leaderboards.
OPENROUTER_SITE_TITLE=PlantWise AI
# OPENROUTER_HTTP_REFERER=https://your-site.example

# --- Climate baseline (Open-Meteo historical archive / ERA5 reanalysis) ---
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
CLIMATE_BASELINE_START_YEAR=2015
CLIMATE_BASELINE_END_YEAR=2024
CLIMATE_CACHE_TTL_HOURS=720

# --- Geocoding ---
# "open-meteo" (default, no key required) or "nominatim"
GEOCODING_PROVIDER=open-meteo
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=PlantWiseAI/1.0 (plant growing suitability demo)
GEOCODING_CACHE_TTL_HOURS=168

# --- Outbound HTTP ---
HTTP_TIMEOUT_SECONDS=30
HTTP_RETRIES=2
